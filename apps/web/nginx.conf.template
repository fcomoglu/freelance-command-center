# Rendered by the nginx image at start; ${API_URL} comes from the environment.

# Behind a TLS-terminating load balancer the original scheme arrives in X-Forwarded-Proto.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    '' $scheme;
}

server {
    listen 80;
    root /usr/share/nginx/html;
    server_tokens off;

    location /api/ {
        proxy_pass ${API_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        # Forwarded platform e-mails are accepted up to 5 MB.
        client_max_body_size 6m;
    }

    # Health of the API (status only) for uptime monitors; the other actuator endpoints stay internal.
    location = /health {
        proxy_pass ${API_URL}/actuator/health;
    }

    # File names of built assets contain their content hash.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Client-side routes; index.html is revalidated so a new release is picked up on the next visit.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
