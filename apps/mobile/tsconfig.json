{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    },
    // expo/types (CSS modules, assets) is also referenced by the generated, git-ignored expo-env.d.ts; listed here so
    // a fresh checkout type-checks.
    "types": ["jest", "expo/types"]
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
