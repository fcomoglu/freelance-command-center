# Local settings of the API: copy to apps/api/.env (git-ignored, read on start) or set them as environment
# variables. Values below are placeholders. Database, Redis and mail come from infra/compose.yaml locally; other
# environments set SPRING_DATASOURCE_*, SPRING_DATA_REDIS_* and SPRING_MAIL_* as environment variables.

# Freelancer.com personal access token (accounts.freelancer.com/settings/develop). The Freelancer.com job sync is
# off while it is empty.
FREELANCER_ACCESS_TOKEN=

# Freelancer.com OAuth app that users connect their accounts to (see README, Platform credentials). Account
# connections are off while FREELANCER_CLIENT_ID is empty.
FREELANCER_CLIENT_ID=
FREELANCER_CLIENT_SECRET=

# Encrypts the stored tokens of connected platform accounts: 32 random bytes in base64 (openssl rand -base64 32).
# Required once a platform's OAuth app is configured.
PLATFORM_TOKEN_KEY=

# Upwork API key and a refresh token from authorizing it once (see README, Platform credentials). The Upwork job
# sync is off while UPWORK_CLIENT_ID is empty.
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_REFRESH_TOKEN=
# true lets users connect their Upwork accounts to read their messages; the API key needs the messaging permission.
UPWORK_ACCOUNT_CONNECTIONS=false

# Forwarded platform e-mails (Fiverr, Bionluk, Arc.dev; see docs/adr/0012): the domain of the workspace inbox
# addresses and the bearer secret of the mail routing service that posts them to /api/v1/inbound-mail. The webhook
# rejects every request while the secret is empty.
INBOUND_MAIL_DOMAIN=inbound.localhost
INBOUND_MAIL_SECRET=

# Expo access token, needed only when "enhanced push security" is enabled for the Expo project.
EXPO_ACCESS_TOKEN=

ANTHROPIC_API_KEY=
