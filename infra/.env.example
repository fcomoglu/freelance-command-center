# Settings of the production stack (infra/compose.prod.yaml): copy to infra/.env on the server (git-ignored).
# The API's own settings go to apps/api/.env (see apps/api/.env.example).

# Host name of the web app and the API, without scheme (e.g. app.example.com).
APP_DOMAIN=

# Password of the PostgreSQL user (openssl rand -base64 24). Changing it later needs ALTER USER as well.
POSTGRES_PASSWORD=

# Token of the Cloudflare Tunnel whose public hostname APP_DOMAIN points to http://web:80.
CLOUDFLARE_TUNNEL_TOKEN=
