#!/bin/sh
# Deploys every push to main (docs/architecture.md#production). Installed on the host as hooks/post-receive of the
# bare repository ~/fcc.git; the checkout is ~/fcc, which also holds the git-ignored .env files and backups.
set -eu

work_tree="$HOME/fcc"

while read -r _old _new ref; do
  if [ "$ref" != "refs/heads/main" ]; then
    echo "Skipping $ref: only main is deployed."
    continue
  fi
  git --work-tree="$work_tree" checkout --force main
  cd "$work_tree"
  docker compose -f infra/compose.prod.yaml up --detach --build --remove-orphans
  # Each release leaves the previous images and build cache behind; the disk is small.
  docker image prune --force > /dev/null
  docker builder prune --force --filter until=168h > /dev/null
done
