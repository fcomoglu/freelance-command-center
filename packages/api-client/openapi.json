{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "REST API for the web, mobile and browser extension clients.",
    "title" : "Freelance Command Center API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "http://localhost",
    "description" : "Generated server url"
  } ],
  "paths" : {
    "/api/v1/auth/email-verification" : {
      "post" : {
        "operationId" : "verifyEmail",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/VerifyEmailRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        },
        "summary" : "Confirm an e-mail address with the token from the verification e-mail",
        "tags" : [ "Authentication" ]
      }
    },
    "/api/v1/auth/password-reset" : {
      "post" : {
        "description" : "Always answers 202 so the endpoint does not reveal registered addresses.",
        "operationId" : "requestPasswordReset",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/PasswordResetRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "202" : {
            "description" : "Accepted"
          }
        },
        "summary" : "E-mail a password reset link",
        "tags" : [ "Authentication" ]
      }
    },
    "/api/v1/auth/password-reset/confirmation" : {
      "post" : {
        "description" : "Signs the user out on every device.",
        "operationId" : "confirmPasswordReset",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/PasswordResetConfirmation"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        },
        "summary" : "Set a new password with the token from the reset e-mail",
        "tags" : [ "Authentication" ]
      }
    },
    "/api/v1/auth/refresh" : {
      "post" : {
        "description" : "Each refresh token works once. Reusing one signs out every device of that session.",
        "operationId" : "refresh",
        "parameters" : [ {
          "in" : "cookie",
          "name" : "fcc_refresh",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "header",
          "name" : "Origin",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SessionResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Exchange a refresh token for a new token pair",
        "tags" : [ "Authentication" ]
      }
    },
    "/api/v1/auth/sign-in" : {
      "post" : {
        "operationId" : "signIn",
        "parameters" : [ {
          "in" : "header",
          "name" : "Origin",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SignInRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SessionResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Sign in with e-mail and password",
        "tags" : [ "Authentication" ]
      }
    },
    "/api/v1/auth/sign-out" : {
      "post" : {
        "operationId" : "signOut",
        "parameters" : [ {
          "in" : "cookie",
          "name" : "fcc_refresh",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "header",
          "name" : "Origin",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        },
        "summary" : "Sign out this device",
        "tags" : [ "Authentication" ]
      }
    },
    "/api/v1/auth/sign-up" : {
      "post" : {
        "description" : "Always answers 202 so the endpoint does not reveal registered addresses. A new user receives a verification e-mail; the owner of an existing account is informed by e-mail.",
        "operationId" : "signUp",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SignUpRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "202" : {
            "description" : "Accepted"
          }
        },
        "summary" : "Create an account",
        "tags" : [ "Authentication" ]
      }
    },
    "/api/v1/devices" : {
      "post" : {
        "description" : "Registering a known push token again moves it to the caller and returns the same id.",
        "operationId" : "register",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/DeviceRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Device"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ {
          "bearer" : [ ]
        } ],
        "summary" : "Register this phone for push notifications",
        "tags" : [ "Devices" ]
      }
    },
    "/api/v1/devices/{deviceId}" : {
      "delete" : {
        "description" : "Does nothing when the device is unknown or belongs to someone else.",
        "operationId" : "unregister",
        "parameters" : [ {
          "in" : "path",
          "name" : "deviceId",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        },
        "security" : [ {
          "bearer" : [ ]
        } ],
        "summary" : "Stop push notifications to a phone",
        "tags" : [ "Devices" ]
      }
    },
    "/api/v1/job-filter" : {
      "get" : {
        "description" : "Decides which new jobs are notified. Without keywords no job is notified.",
        "operationId" : "get",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/JobFilter"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ {
          "bearer" : [ ]
        } ],
        "summary" : "The workspace's job filter",
        "tags" : [ "Job filter" ]
      },
      "put" : {
        "operationId" : "change",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/JobFilterRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/JobFilter"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ {
          "bearer" : [ ]
        } ],
        "summary" : "Replace the workspace's job filter",
        "tags" : [ "Job filter" ]
      }
    },
    "/api/v1/jobs" : {
      "get" : {
        "operationId" : "jobs",
        "parameters" : [ {
          "description" : "Only jobs of this platform",
          "in" : "query",
          "name" : "platform",
          "required" : false,
          "schema" : {
            "type" : "string",
            "enum" : [ "freelancer", "upwork", "fiverr", "bionluk", "arc_dev" ]
          }
        }, {
          "description" : "`nextCursor` of the previous page",
          "in" : "query",
          "name" : "cursor",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "limit",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 20,
            "maximum" : 100,
            "minimum" : 1
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PageResponseJob"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ {
          "bearer" : [ ]
        } ],
        "summary" : "The job feed, newest posting first",
        "tags" : [ "Jobs" ]
      }
    },
    "/api/v1/me" : {
      "get" : {
        "operationId" : "me",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ {
          "bearer" : [ ]
        } ],
        "summary" : "The signed-in user",
        "tags" : [ "Account" ]
      }
    },
    "/api/v1/me/email-verification" : {
      "post" : {
        "description" : "Earlier links stop working. Does nothing when the address is already verified.",
        "operationId" : "resendVerification",
        "responses" : {
          "202" : {
            "description" : "Accepted"
          }
        },
        "security" : [ {
          "bearer" : [ ]
        } ],
        "summary" : "Send a new verification e-mail",
        "tags" : [ "Account" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "Device" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string"
          }
        },
        "required" : [ "id" ]
      },
      "DeviceRequest" : {
        "type" : "object",
        "properties" : {
          "language" : {
            "type" : "string",
            "description" : "Language of the notification texts",
            "enum" : [ "en", "tr" ],
            "maxLength" : 35,
            "minLength" : 0
          },
          "pushToken" : {
            "type" : "string",
            "description" : "Expo push token",
            "example" : "ExponentPushToken[xxxxxxxxxxxxxxxxxxxxxx]",
            "maxLength" : 255,
            "minLength" : 0
          }
        },
        "required" : [ "language", "pushToken" ]
      },
      "Job" : {
        "type" : "object",
        "properties" : {
          "bidCount" : {
            "type" : "integer",
            "format" : "int32"
          },
          "budget" : {
            "$ref" : "#/components/schemas/JobBudget"
          },
          "description" : {
            "type" : "string",
            "description" : "Plain text; empty when the platform gives none"
          },
          "id" : {
            "type" : "string"
          },
          "language" : {
            "type" : "string",
            "description" : "ISO 639-1 code of the listing's language"
          },
          "platform" : {
            "type" : "string",
            "enum" : [ "freelancer", "upwork", "fiverr", "bionluk", "arc_dev" ]
          },
          "postedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "skills" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "title" : {
            "type" : "string"
          },
          "url" : {
            "type" : "string",
            "description" : "The listing on its platform"
          }
        },
        "required" : [ "description", "id", "platform", "postedAt", "skills", "title", "url" ]
      },
      "JobBudget" : {
        "type" : "object",
        "properties" : {
          "maximum" : {
            "$ref" : "#/components/schemas/Money",
            "description" : "Absent for a single amount"
          },
          "minimum" : {
            "$ref" : "#/components/schemas/Money"
          },
          "type" : {
            "type" : "string",
            "enum" : [ "fixed", "hourly" ]
          }
        },
        "required" : [ "minimum", "type" ]
      },
      "JobFilter" : {
        "type" : "object",
        "properties" : {
          "keywords" : {
            "type" : "array",
            "description" : "Lower-case, in the order given",
            "items" : {
              "type" : "string"
            }
          },
          "platforms" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "enum" : [ "freelancer", "upwork", "fiverr", "bionluk", "arc_dev" ]
            }
          }
        },
        "required" : [ "keywords", "platforms" ]
      },
      "JobFilterRequest" : {
        "type" : "object",
        "properties" : {
          "keywords" : {
            "type" : "array",
            "description" : "Whole words or phrases, matched case-insensitively; duplicates are dropped",
            "items" : {
              "type" : "string",
              "maxLength" : 50,
              "minLength" : 0
            },
            "maxItems" : 20,
            "minItems" : 0
          },
          "platforms" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "enum" : [ "freelancer", "upwork", "fiverr", "bionluk", "arc_dev" ]
            }
          }
        },
        "required" : [ "keywords", "platforms" ]
      },
      "MeResponse" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string"
          },
          "emailVerified" : {
            "type" : "boolean"
          },
          "language" : {
            "type" : "string"
          },
          "userId" : {
            "type" : "string"
          },
          "workspaceId" : {
            "type" : "string"
          }
        },
        "required" : [ "email", "emailVerified", "language", "userId", "workspaceId" ]
      },
      "Money" : {
        "type" : "object",
        "properties" : {
          "amount" : {
            "type" : "string",
            "example" : "1250.00",
            "pattern" : "^\\d{1,15}(\\.\\d{1,4})?$"
          },
          "currency" : {
            "type" : "string",
            "example" : "USD",
            "pattern" : "^[A-Z]{3}$"
          }
        },
        "required" : [ "amount", "currency" ]
      },
      "PageResponseJob" : {
        "type" : "object",
        "properties" : {
          "items" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/Job"
            }
          },
          "nextCursor" : {
            "type" : "string"
          }
        },
        "required" : [ "items" ]
      },
      "PasswordResetConfirmation" : {
        "type" : "object",
        "properties" : {
          "newPassword" : {
            "type" : "string",
            "maxLength" : 128,
            "minLength" : 0
          },
          "token" : {
            "type" : "string",
            "maxLength" : 128,
            "minLength" : 0
          }
        },
        "required" : [ "newPassword", "token" ]
      },
      "PasswordResetRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "maxLength" : 254,
            "minLength" : 0
          }
        },
        "required" : [ "email" ]
      },
      "RefreshRequest" : {
        "type" : "object",
        "properties" : {
          "refreshToken" : {
            "type" : "string",
            "description" : "Required for clients without a browser origin",
            "maxLength" : 128,
            "minLength" : 0
          }
        }
      },
      "SessionResponse" : {
        "type" : "object",
        "properties" : {
          "accessToken" : {
            "type" : "string"
          },
          "accessTokenExpiresAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "refreshToken" : {
            "type" : "string",
            "description" : "Only for clients without a browser origin; browsers get an HttpOnly cookie"
          },
          "refreshTokenExpiresAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        },
        "required" : [ "accessToken", "accessTokenExpiresAt", "refreshTokenExpiresAt" ]
      },
      "SignInRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "maxLength" : 254,
            "minLength" : 0
          },
          "password" : {
            "type" : "string",
            "maxLength" : 128,
            "minLength" : 0
          }
        },
        "required" : [ "email", "password" ]
      },
      "SignUpRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "maxLength" : 254,
            "minLength" : 0
          },
          "language" : {
            "type" : "string",
            "description" : "Language of e-mails; defaults to the Accept-Language header",
            "enum" : [ "en", "tr" ],
            "maxLength" : 35,
            "minLength" : 0
          },
          "password" : {
            "type" : "string",
            "maxLength" : 128,
            "minLength" : 0
          }
        },
        "required" : [ "email", "password" ]
      },
      "VerifyEmailRequest" : {
        "type" : "object",
        "properties" : {
          "token" : {
            "type" : "string",
            "maxLength" : 128,
            "minLength" : 0
          }
        },
        "required" : [ "token" ]
      }
    },
    "securitySchemes" : {
      "bearer" : {
        "bearerFormat" : "JWT",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  }
}
