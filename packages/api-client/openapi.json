{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "REST API for the web, mobile and browser extension clients.",
    "title" : "Freelance Command Center API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "http://localhost",
    "description" : "Generated server url"
  } ],
  "paths" : {
    "/api/v1/auth/email-verification" : {
      "post" : {
        "operationId" : "verifyEmail",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/VerifyEmailRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        },
        "summary" : "Confirm an e-mail address with the token from the verification e-mail",
        "tags" : [ "Authentication" ]
      }
    },
    "/api/v1/auth/refresh" : {
      "post" : {
        "description" : "Each refresh token works once. Reusing one signs out every device of that session.",
        "operationId" : "refresh",
        "parameters" : [ {
          "in" : "cookie",
          "name" : "fcc_refresh",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "header",
          "name" : "Origin",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SessionResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Exchange a refresh token for a new token pair",
        "tags" : [ "Authentication" ]
      }
    },
    "/api/v1/auth/sign-in" : {
      "post" : {
        "operationId" : "signIn",
        "parameters" : [ {
          "in" : "header",
          "name" : "Origin",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SignInRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SessionResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Sign in with e-mail and password",
        "tags" : [ "Authentication" ]
      }
    },
    "/api/v1/auth/sign-out" : {
      "post" : {
        "operationId" : "signOut",
        "parameters" : [ {
          "in" : "cookie",
          "name" : "fcc_refresh",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "header",
          "name" : "Origin",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        },
        "summary" : "Sign out this device",
        "tags" : [ "Authentication" ]
      }
    },
    "/api/v1/auth/sign-up" : {
      "post" : {
        "description" : "Always answers 202 so the endpoint does not reveal registered addresses. A new user receives a verification e-mail; the owner of an existing account is informed by e-mail.",
        "operationId" : "signUp",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SignUpRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "202" : {
            "description" : "Accepted"
          }
        },
        "summary" : "Create an account",
        "tags" : [ "Authentication" ]
      }
    },
    "/api/v1/me" : {
      "get" : {
        "operationId" : "me",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ {
          "bearer" : [ ]
        } ],
        "summary" : "The signed-in user",
        "tags" : [ "Account" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "MeResponse" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string"
          },
          "emailVerified" : {
            "type" : "boolean"
          },
          "language" : {
            "type" : "string"
          },
          "userId" : {
            "type" : "string"
          },
          "workspaceId" : {
            "type" : "string"
          }
        },
        "required" : [ "email", "emailVerified", "language", "userId", "workspaceId" ]
      },
      "RefreshRequest" : {
        "type" : "object",
        "properties" : {
          "refreshToken" : {
            "type" : "string",
            "description" : "Required for clients without a browser origin",
            "maxLength" : 128,
            "minLength" : 0
          }
        }
      },
      "SessionResponse" : {
        "type" : "object",
        "properties" : {
          "accessToken" : {
            "type" : "string"
          },
          "accessTokenExpiresAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "refreshToken" : {
            "type" : "string",
            "description" : "Only for clients without a browser origin; browsers get an HttpOnly cookie"
          },
          "refreshTokenExpiresAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        },
        "required" : [ "accessToken", "accessTokenExpiresAt", "refreshTokenExpiresAt" ]
      },
      "SignInRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "maxLength" : 254,
            "minLength" : 0
          },
          "password" : {
            "type" : "string",
            "maxLength" : 128,
            "minLength" : 0
          }
        },
        "required" : [ "email", "password" ]
      },
      "SignUpRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "maxLength" : 254,
            "minLength" : 0
          },
          "language" : {
            "type" : "string",
            "description" : "Language of e-mails; defaults to the Accept-Language header",
            "enum" : [ "en", "tr" ],
            "maxLength" : 35,
            "minLength" : 0
          },
          "password" : {
            "type" : "string",
            "maxLength" : 128,
            "minLength" : 0
          }
        },
        "required" : [ "email", "password" ]
      },
      "VerifyEmailRequest" : {
        "type" : "object",
        "properties" : {
          "token" : {
            "type" : "string",
            "maxLength" : 128,
            "minLength" : 0
          }
        },
        "required" : [ "token" ]
      }
    },
    "securitySchemes" : {
      "bearer" : {
        "bearerFormat" : "JWT",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  }
}
